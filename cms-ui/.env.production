# Don't add `/` after the URL
# NEXT_PUBLIC_REST_API_ENDPOINT="https://mock.redq.io/api"
# NEXT_PUBLIC_REST_API_ENDPOINT_EV="http://192.168.0.125:8080"
NEXT_PUBLIC_REST_API_ENDPOINT_EV="https://be.aqua.gift"

# Authentication key
NEXT_PUBLIC_AUTH_TOKEN_KEY=AUTH_CRED

# Default Language
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Multilang
# Before enabling multilingual make sure your API supports multilingual
NEXT_PUBLIC_ENABLE_MULTI_LANG=true
NEXT_PUBLIC_AVAILABLE_LANGUAGES=en

# Files
# NEXT_PUBLIC_FILE_API_ENDPOINT="http://192.168.105.201:4000"
NEXT_PUBLIC_FILE_API_ENDPOINT="https://ev-img.aqua.gift"
# NEXT_PUBLIC_FILE_API_ENDPOINT=http://192.168.105.201:4000
NEXT_PUBLIC_FILE_API_ENDPOINT_LOCAL="http://image-server-cluster-ip-service"
