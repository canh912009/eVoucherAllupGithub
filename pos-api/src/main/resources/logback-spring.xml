<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--    <property name="LOGS" value="/Documents/regen" />-->
    <!--    <property name="LOGS" value="${catalina.base}/logs/e_voucher/core/publish_service" />-->
    <springProperty name="LOGS" source="location.log"/>

    <appender name="Console"
              class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                [%date{ISO8601}] %highlight([%-5level]) [%thread] %logger{32} - %msg%n%throwable
            </Pattern>
        </layout>
    </appender>

    <!-- LOG everything at INFO level -->
    <root level="info">
        <appender-ref ref="Console" />
    </root>

    <!-- LOG "com.castis*" at TRACE level -->
    <logger name="com.castis" level="info" additivity="false">
        <appender-ref ref="Console" />
    </logger>

</configuration>
